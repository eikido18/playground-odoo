<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="address_form_fields" inherit_id="portal.address_form_fields">
        <xpath expr="//label[@for='o_name']" position="replace">
            <label class="col-form-label" for="o_name">First and last name</label>
        </xpath>
        <xpath expr="//input[@id='o_name']" position="attributes">
            <attribute name="placeholder">e.g. John Smith</attribute>
        </xpath>
    </template>

    <template id="signup" inherit_id="auth_signup.signup">
        <xpath expr="//label[@for='name']" position="replace">
            <label for="name" class="form-label">First and last name</label>
        </xpath>
        <xpath expr="//input[@name='name']" position="attributes">
            <attribute name="class"/>
            <attribute name="t-attf-class">form-control #{'is-invalid' if invalid_name else ''}</attribute>
            <attribute name="placeholder">e.g. John Smith</attribute>
        </xpath>
    </template>

</odoo>
